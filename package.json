{
  "name": "wager-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "migrate": "bun src/cli/migrate.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun run typecheck && bun test --timeout 120000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 120000",
    "test:concurrency": "bun test test/concurrency --timeout 120000",
    "bench:triggers": "bun test/bench/deferred-triggers.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "typescript": "5"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@mikro-orm/core": "^7.2.8",
    "@mikro-orm/migrations": "^7.2.8",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.8",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "canonicalize": "5.1.0",
    "decimal.js": "^10.6.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}